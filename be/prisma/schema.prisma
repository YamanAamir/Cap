generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                     @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  password              String
  role                  String                  @default("user")
  createdAt             DateTime                @default(now())
  productionBatchesSent ProductionBatch[]
  dispatchLogs          ProductionDispatchLog[]
}

model Flag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                    Int                     @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  phone                 String?                 @unique
  school                String?
  orderEmailConsent     Boolean                 @default(true)
  smsMarketingConsent   Boolean                 @default(false)
  emailMarketingConsent Boolean                 @default(false)
  smsConsentAt          DateTime?
  gdprConsentAt         DateTime?
  smsOptOut             Boolean                 @default(false)
  smsOptOutAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  orders                Order[]
  discountCodes         DiscountCode[]
  smsMessages           SmsMessage[]
  campaignEnrollments   SmsCampaignEnrollment[]
}

model OrderStatus {
  id                    Int            @id @default(autoincrement())
  name                  String         @unique
  slug                  String         @unique
  sortOrder             Int            @default(0)
  isInternal            Boolean        @default(false)
  isVisibleToProduction Boolean        @default(true)
  triggersProduction    Boolean        @default(false)
  isActive              Boolean        @default(true)
  color                 String         @default("#6366f1")
  customerEmailTemplateId Int?
  emailTemplate         EmailTemplate? @relation(fields: [customerEmailTemplateId], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  orders                Order[]
}

model Order {
  id              Int      @id @default(autoincrement())
  orderNumber     String
  customerEmail   String
  customerDetails Json
  selectedOptions Json
  totalPrice      Float
  currency        String
  orderDate       DateTime @default(now())
  status          String   @default("PENDING")
  packageName     String?
  program         String?

  customerId       Int?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  statusId         Int?
  orderStatus      OrderStatus?  @relation(fields: [statusId], references: [id])
  discountCodeId   Int?
  discountCode     DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountAmount   Float?
  capImages        Json?
  productionBatchId Int?
  productionBatch  ProductionBatch? @relation(fields: [productionBatchId], references: [id])

  installmentPlanId  Int?
  installmentPlan    InstallmentPlan? @relation(fields: [installmentPlanId], references: [id])
  installmentDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscountCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  type          String
  value         Float
  expiresAt     DateTime
  isActive      Boolean   @default(true)
  phoneNumber   String?
  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id])
  usedAt        DateTime?
  usedByOrderId Int?
  source        String?
  createdAt     DateTime  @default(now())
  orders        Order[]
  enrollments   SmsCampaignEnrollment[]

  @@index([customerId])
}

model SmsCampaign {
  id            Int                     @id @default(autoincrement())
  name          String
  slug          String?                  @unique @default(uuid())
  isActive      Boolean                 @default(true)
  discountType  String?                 // 'PERCENTAGE' or 'AMOUNT'
  discountValue Float?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  steps         SmsCampaignStep[]
  enrollments   SmsCampaignEnrollment[]
}

model SmsCampaignStep {
  id         Int         @id @default(autoincrement())
  campaignId Int
  campaign   SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dayOffset  Int
  message    String      @db.Text
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
}

model SmsCampaignEnrollment {
  id             Int          @id @default(autoincrement())
  campaignId     Int
  campaign       SmsCampaign  @relation(fields: [campaignId], references: [id])
  customerId     Int
  customer       Customer     @relation(fields: [customerId], references: [id])
  discountCodeId Int?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  enrolledAt     DateTime     @default(now())
  completedAt    DateTime?
  messages       SmsMessage[]
}

model SmsMessage {
  id           Int                    @id @default(autoincrement())
  customerId   Int
  customer     Customer               @relation(fields: [customerId], references: [id])
  enrollmentId Int?
  enrollment   SmsCampaignEnrollment? @relation(fields: [enrollmentId], references: [id])
  phone        String
  message      String                 @db.Text
  status       String                 @default("SCHEDULED")
  gatewayId    String?                @unique
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime               @default(now())
}

model ExcelColumnConfig {
  id          Int      @id @default(autoincrement())
  fieldKey    String   @unique
  headerLabel String
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionBatch {
  id             Int                     @id @default(autoincrement())
  status         String                  @default("DRAFT")
  orderCount     Int                     @default(0)
  excelFilePath  String?
  zipFilePath    String?
  emailSubject   String?
  emailBody      String?                 @db.Text
  recipientEmail String?
  sentAt         DateTime?
  sentByUserId   Int?
  sentByUser     User?                   @relation(fields: [sentByUserId], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  orders         Order[]
  logs           ProductionDispatchLog[]
}

model ProductionDispatchLog {
  id          Int             @id @default(autoincrement())
  batchId     Int
  batch       ProductionBatch @relation(fields: [batchId], references: [id])
  adminUserId Int
  adminUser   User            @relation(fields: [adminUserId], references: [id])
  orderCount  Int
  fileNames   Json
  sentAt      DateTime        @default(now())
}

model EmailTemplate {
  id        Int           @id @default(autoincrement())
  key       String        @unique
  name      String?
  subject   String
  body      String        @db.Text
  updatedAt DateTime      @updatedAt
  statuses  OrderStatus[]
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Json
}

model TempOrder {
  id        String   @id @default(uuid())
  orderData Json
  createdAt DateTime @default(now())
}

model InstallmentPlan {
  id                  Int      @id @default(autoincrement())
  name                String
  program             String   // "STX" | "HHX" | ... | "all"
  packageTier         String   // "standard" | "luksus" | "premium" | "all"
  isActive            Boolean  @default(true)
  downPaymentPercent  Float    // % of total price e.g. 35 means 35%
  installments        Json     // [{ label: String, dueLabel: String, percent: Float }]
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orders              Order[]
}
