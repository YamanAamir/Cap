generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                     @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  password              String
  role                  String                  @default("user")
  createdAt             DateTime                @default(now())
  productionBatchesSent ProductionBatch[]
  dispatchLogs          ProductionDispatchLog[]
}

model Flag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                    Int                     @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  phone                 String?                 @unique
  orderEmailConsent     Boolean                 @default(true)
  smsMarketingConsent   Boolean                 @default(false)
  emailMarketingConsent Boolean                 @default(false)
  smsConsentAt          DateTime?
  gdprConsentAt         DateTime?
  smsOptOut             Boolean                 @default(false)
  smsOptOutAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  school                String?
  discountCodes         DiscountCode[]
  orders                Order[]
  campaignEnrollments   SmsCampaignEnrollment[]
  smsMessages           SmsMessage[]
}

model OrderStatus {
  id                      Int            @id @default(autoincrement())
  name                    String         @unique
  slug                    String         @unique
  sortOrder               Int            @default(0)
  isInternal              Boolean        @default(false)
  triggersProduction      Boolean        @default(false)
  isActive                Boolean        @default(true)
  color                   String         @default("#6366f1")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  customerEmailTemplateId Int?
  isVisibleToProduction   Boolean        @default(true)
  installmentTriggerIndex Int?
  isInstallmentTrigger    Boolean        @default(false)
  orders                  Order[]
  emailTemplate           EmailTemplate? @relation(fields: [customerEmailTemplateId], references: [id])

  @@index([customerEmailTemplateId], map: "OrderStatus_customerEmailTemplateId_fkey")
}

model Order {
  id                 Int              @id @default(autoincrement())
  orderNumber        String
  customerEmail      String
  customerDetails    String           @db.LongText
  selectedOptions    String           @db.LongText
  totalPrice         Float
  currency           String
  orderDate          DateTime         @default(now())
  status             String           @default("PENDING")
  packageName        String?
  program            String?
  customerId         Int?
  statusId           Int?
  discountCodeId     Int?
  discountAmount     Float?
  capImages          String?          @db.LongText
  productionBatchId  Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  installmentDetails String?          @db.LongText
  installmentPlanId  Int?
  customer           Customer?        @relation(fields: [customerId], references: [id])
  discountCode       DiscountCode?    @relation(fields: [discountCodeId], references: [id])
  installmentPlan    InstallmentPlan? @relation(fields: [installmentPlanId], references: [id])
  productionBatch    ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  orderStatus        OrderStatus?     @relation(fields: [statusId], references: [id])

  @@index([customerId], map: "Order_customerId_fkey")
  @@index([discountCodeId], map: "Order_discountCodeId_fkey")
  @@index([installmentPlanId], map: "Order_installmentPlanId_fkey")
  @@index([productionBatchId], map: "Order_productionBatchId_fkey")
  @@index([statusId], map: "Order_statusId_fkey")
}

model DiscountCode {
  id            Int                     @id @default(autoincrement())
  code          String                  @unique
  type          String
  value         Float
  expiresAt     DateTime
  isActive      Boolean                 @default(true)
  phoneNumber   String?
  customerId    Int?
  usedAt        DateTime?
  usedByOrderId Int?
  source        String?
  createdAt     DateTime                @default(now())
  customer      Customer?               @relation(fields: [customerId], references: [id])
  orders        Order[]
  enrollments   SmsCampaignEnrollment[]

  @@index([customerId])
}

model SmsCampaign {
  id                        Int                     @id @default(autoincrement())
  name                      String
  slug                      String?                 @unique @default(uuid())
  isActive                  Boolean                 @default(true)
  discountType              String?                 // 'PERCENTAGE' or 'AMOUNT'
  discountValue             Float?
  weekdaySendTime           String?                 @default("16:00")
  weekendSendTime           String?                 @default("12:00")
  allowedDays               String?                 @db.LongText
  sendImmediateOnEnrollment Boolean                 @default(true)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  steps                     SmsCampaignStep[]
  enrollments               SmsCampaignEnrollment[]
}

model SmsCampaignStep {
  id         Int         @id @default(autoincrement())
  campaignId Int
  dayOffset  Int
  message    String      @db.Text
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  campaign   SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId], map: "SmsCampaignStep_campaignId_fkey")
}

model SmsCampaignEnrollment {
  id             Int           @id @default(autoincrement())
  campaignId     Int
  customerId     Int
  discountCodeId Int?
  enrolledAt     DateTime      @default(now())
  completedAt    DateTime?
  campaign       SmsCampaign   @relation(fields: [campaignId], references: [id], onDelete: NoAction)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction)
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  messages       SmsMessage[]

  @@index([campaignId], map: "SmsCampaignEnrollment_campaignId_fkey")
  @@index([customerId], map: "SmsCampaignEnrollment_customerId_fkey")
  @@index([discountCodeId], map: "SmsCampaignEnrollment_discountCodeId_fkey")
}

model SmsMessage {
  id           Int                    @id @default(autoincrement())
  customerId   Int
  enrollmentId Int?
  phone        String
  message      String                 @db.Text
  status       String                 @default("SCHEDULED")
  gatewayId    String?                @unique
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime               @default(now())
  customer     Customer               @relation(fields: [customerId], references: [id], onDelete: NoAction)
  enrollment   SmsCampaignEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@index([customerId], map: "SmsMessage_customerId_fkey")
  @@index([enrollmentId], map: "SmsMessage_enrollmentId_fkey")
}

model ExcelColumnConfig {
  id          Int      @id @default(autoincrement())
  fieldKey    String   @unique
  headerLabel String
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionBatch {
  id             Int                     @id @default(autoincrement())
  status         String                  @default("DRAFT")
  orderCount     Int                     @default(0)
  excelFilePath  String?
  zipFilePath    String?
  emailSubject   String?
  emailBody      String?                 @db.Text
  recipientEmail String?
  sentAt         DateTime?
  sentByUserId   Int?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  orders         Order[]
  sentByUser     User?                   @relation(fields: [sentByUserId], references: [id])
  logs           ProductionDispatchLog[]

  @@index([sentByUserId], map: "ProductionBatch_sentByUserId_fkey")
}

model ProductionDispatchLog {
  id          Int             @id @default(autoincrement())
  batchId     Int
  adminUserId Int
  orderCount  Int
  fileNames   String          @db.LongText
  sentAt      DateTime        @default(now())
  adminUser   User            @relation(fields: [adminUserId], references: [id], onDelete: NoAction)
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: NoAction)

  @@index([adminUserId], map: "ProductionDispatchLog_adminUserId_fkey")
  @@index([batchId], map: "ProductionDispatchLog_batchId_fkey")
}

model EmailTemplate {
  id        Int           @id @default(autoincrement())
  key       String        @unique
  subject   String
  body      String        @db.Text
  updatedAt DateTime      @updatedAt
  name      String?
  statuses  OrderStatus[]
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.LongText
}

model TempOrder {
  id        String   @id @default(uuid())
  orderData String   @db.LongText
  createdAt DateTime @default(now())
}

model InstallmentPlan {
  id                Int      @id @default(autoincrement())
  name              String
  program           String
  packageTier       String
  isActive          Boolean  @default(true)
  installments      String   @db.LongText
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  downPaymentAmount Float    @default(399)
  orders            Order[]
}

model WebshopProduct {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  shortDescription String?  @db.Text
  longDescription  String?  @db.Text
  price            Float    @default(0)
  stockCount       Int      @default(0)
  isActive         Boolean  @default(true)
  isOutOfStock     Boolean  @default(false)
  images           String?   @db.LongText
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebshopCustomer {
  id        Int            @id @default(autoincrement())
  name      String
  email     String         @unique
  phone     String?
  address   String?         @db.LongText
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  orders    WebshopOrder[]
}

model WebshopOrder {
  id                Int              @id @default(autoincrement())
  orderNumber       String           @unique
  stripeSessionId   String?          @unique
  customerEmail     String
  customerDetails   String           @db.LongText
  shippingAddress   String?          @db.LongText
  items             String   	       @db.LongText
  totalAmount       Float
  currency          String           @default("DKK")
  paymentStatus     String           @default("PAID")
  orderStatus       String           @default("PENDING")
  orderDate         DateTime         @default(now())
  webshopCustomerId Int?
  webshopCustomer   WebshopCustomer? @relation(fields: [webshopCustomerId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model WebshopEmailTemplate {
  id              Int                  @id @default(autoincrement())
  key             String               @unique
  name            String?
  subject         String
  body            String               @db.Text
  sortOrder       Int                  @default(0)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  webshopStatuses WebshopOrderStatus[]
}

model WebshopOrderStatus {
  id                     Int                   @id @default(autoincrement())
  name                   String                @unique
  slug                   String                @unique
  color                  String                @default("#6366f1")
  sortOrder              Int                   @default(0)
  isActive               Boolean               @default(true)
  webshopEmailTemplateId Int?
  emailTemplate          WebshopEmailTemplate? @relation(fields: [webshopEmailTemplateId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}